# ─── Local Development (SQLite) ──────────────────────────────────────────────
# Default local SQLite file — works out of the box with `npm run dev`
DATABASE_URL="file:./prisma/dev.db"

# ─── Production (Turso / LibSQL) ──────────────────────────────────────────────
# Get these from https://app.turso.tech after creating a database:
#   1. Go to your database → Settings → Connection String → copy the URL
#   2. Go to your database → Settings → Tokens → Create token → copy the token
#
# DATABASE_URL="libsql://your-db-name-your-username.turso.io"
# DATABASE_AUTH_TOKEN="your-turso-auth-token"

# ─── Auth (JWT) ───────────────────────────────────────────────────────────────
# Generate a strong secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="dev-secret-change-in-production"

# ─── Public URLs ──────────────────────────────────────────────────────────────
# Your deployed Vercel URL, e.g. https://sweet-crust.vercel.app
NEXT_PUBLIC_SITE_URL="https://sweetcrust.rw"
